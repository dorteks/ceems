datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ServiceCenter {
  AYEPE_1
  AYEPE_2
  AYETORO
  GRA
  KELEBE_1
  KELEBE_2
  OGO_OLUWA
  OKE_FIA
  OSOGBO_1
  OSOGBO_2
  OTA_EFUN
}

enum CustomerType {
  PREPAID
  POSTPAID
}

enum MeterType {
  PREPAID
  POSTPAID
}

enum PremiseType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  GOVERNMENT
}

enum MeterPhase {
  Q1
  Q3
  WHOLE_CURRENT
  LVMD
  HVMD
}

enum CustomerCategory {
  MD1
  MD2
  NMD
}

model Customer {
  id                        Int              @id @default(autoincrement())
  
  // Account and meter
  account_number            String           @unique
  meter_number              String?          @unique

  // Personal information
  surname                   String
  first_name                String
  other_name                String?
  nin                       String?          @unique

  // Customer classification
  customer_type             CustomerType?
  customer_category         CustomerCategory?
  premise_type              PremiseType?
  meter_type                MeterType?
  meter_phase               MeterPhase?

  // Location / service
  address                   String?
  city                      String?
  state                     String?
  lga                       String?
  service_center            ServiceCenter?
  service_code              String?
  tariff                    String?
  longitude                 Float?
  latitude                  Float?

  // Contact
  email                     String?          @unique
  phone                     String?

  // Business
  nature_of_business        String?

  // Feeder / grid
  dss_id                    String?
  dss_name                  String?
  feeder_id                 String?
  feeder_name               String?
  feeder_band               String?
  status                    String?
  business_hub              String?
  region                    String?

  // Enumerator
  enumerator_name           String?
  enumerator_id             String?
  enumerator_phone_number   String?
  remark                    String?

  // Audit
  created_at                DateTime         @default(now())
  updated_at                DateTime         @updatedAt
  created_by                String?
  updated_by                String?

  @@index([meter_number])
  @@index([customer_type])
  @@index([customer_category])
  @@index([service_center])
  @@index([state])
  @@index([lga])
  @@index([dss_id])
  @@index([feeder_id])
  @@index([enumerator_id])
  @@index([status])
}
